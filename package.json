    "react-native-image-picker": "^7.1.0",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-fs": "^2.20.0",
    "react-native-permissions": "^4.1.4",
    "react-native-offline": "^6.0.2",
    "react-native-netinfo": "^11.3.1",
    "react-native-uuid": "^2.0.1",
