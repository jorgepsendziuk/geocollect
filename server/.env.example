# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=geocollect
DB_USER=postgres
DB_PASSWORD=your_password

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=your_jwt_secret_key_here
BCRYPT_ROUNDS=10

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Sync Configuration
SYNC_INTERVAL=300000
MAX_SYNC_RETRIES=3